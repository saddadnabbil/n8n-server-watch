# Comma-separated list of name|url pairs to watch.
WATCH_TARGETS=demo|http://demo-target,example|https://example.com

# Optional: Claude writes a short incident summary. Leave empty to send raw alerts only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: where alerts are delivered. Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: protect the status page. Open it as /webhook/server-watch?token=<value>.
STATUS_TOKEN=
