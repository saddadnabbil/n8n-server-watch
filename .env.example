# Comma-separated list of name|url pairs to watch.
WATCH_TARGETS=demo|http://demo-target,example|https://example.com

# Optional: Claude writes a short incident summary. Leave empty to send raw alerts only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: where alerts are delivered. Create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: protect the status page. Open it as /webhook/server-watch?token=<value>.
STATUS_TOKEN=

# Optional: email alerts over SMTP. Run scripts/import-smtp-credential.sh after changing these.
# Port 587 uses STARTTLS (SMTP_SECURE=false); port 465 uses SSL (SMTP_SECURE=true).
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
